# AI Provider Configuration
# Set your Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# Or set your OpenAI API Key / Compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred LLM model (e.g. gemini-3.6-flash, gemini-2.0-flash, gpt-4o, gpt-4o-mini)
LLM_MODEL=gemini-3.6-flash

# If no API key is provided, the application seamlessly runs with high-fidelity Demo Simulation Mode.
